+/// Aerosol products have one metadata vocabulary for any species name.
+/// No chemistry mass is inferred from meteorological steering fields.
+pub fn chemistry_product_units(name: &str) -> Option<&'static str> {
+    if name == "aod550" || name.ends_with("_aod550") { Some("1") }
+    else if name.ends_with("_surface_concentration") { Some("ug m-3") }
+    else if ["_column_mass", "_dry_deposition", "_settled_mass"].iter().any(|s| name.ends_with(s)) {
+        Some("kg m-2")
+    } else { None }
+}
 
